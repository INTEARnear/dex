---
source: intear-dex-management/tests/xyk_writes.rs
expression: "cli.transaction(\"alice.near\",\n&[\"xyk\", \"swap\", \"alice.near\", \"0\", \"sell\", \"0.5 NEAR\", \"max-slippage\", \"1%\",\n\"from-balance\", \"to-balance\", \"--referrer\", \"bob.near\"]).await"
